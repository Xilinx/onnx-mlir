// CHECK:           %[[VAL_15:.*]] = "onnx.ReverseSequence"(%[[VAL_14]], %[[VAL_11]]) {batch_axis = 0 : si64, time_axis = 1 : si64} : (tensor<2x2x64x32xf32>, tensor<2xi64>) -> tensor<2x2x64x32xf32>
// CHECK:           %[[VAL_16:.*]] = "onnx.Transpose"(%[[VAL_15]]) {perm = [2, 3, 0, 1]} : (tensor<2x2x64x32xf32>) -> tensor<64x32x2x2xf32>
// CHECK:           %[[VAL_17:.*]] = "onnx.Transpose"(%[[VAL_16]]) {perm = [1, 0, 2, 3]} : (tensor<64x32x2x2xf32>) -> tensor<32x64x2x2xf32>
// CHECK:           %[[VAL_18:.*]] = "onnx.Slice"(%[[VAL_17]], %[[VAL_9]], %[[VAL_11]], %[[VAL_10]], %[[VAL_11]]) : (tensor<32x64x2x2xf32>, tensor<2xi64>, tensor<2xi64>, tensor<2xi64>, tensor<2xi64>) -> tensor<32x64x1x1xf32>
// CHECK:           %[[VAL_19:.*]] = "onnx.Slice"(%[[VAL_17]], %[[VAL_8]], %[[VAL_7]], %[[VAL_10]], %[[VAL_11]]) : (tensor<32x64x2x2xf32>, tensor<2xi64>, tensor<2xi64>, tensor<2xi64>, tensor<2xi64>) -> tensor<32x64x1x1xf32>
// CHECK:           %[[VAL_20:.*]] = "onnx.Slice"(%[[VAL_17]], %[[VAL_6]], %[[VAL_10]], %[[VAL_10]], %[[VAL_11]]) : (tensor<32x64x2x2xf32>, tensor<2xi64>, tensor<2xi64>, tensor<2xi64>, tensor<2xi64>) -> tensor<32x64x1x1xf32>
// CHECK:           %[[VAL_21:.*]] = "onnx.Slice"(%[[VAL_17]], %[[VAL_5]], %[[VAL_4]], %[[VAL_10]], %[[VAL_11]]) : (tensor<32x64x2x2xf32>, tensor<2xi64>, tensor<2xi64>, tensor<2xi64>, tensor<2xi64>) -> tensor<32x64x1x1xf32>
