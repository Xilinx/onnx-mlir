// to 4 separate convs, still merged with Reshape->Transpose->Reshape).


// CHECK-LABEL:   func.func @test_sep_4phase_kernel_22(
// CHECK-SAME:                                         %[[VAL_0:.*]]: tensor<1x64x8x8xf32>,
